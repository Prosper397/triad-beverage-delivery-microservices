# Copiez ce fichier en .env et remplissez vos propres valeurs.
# Le fichier .env ne doit JAMAIS être poussé sur GitHub.

# Supabase > Project Settings > Database > Connection string
DATABASE_URL=postgresql+psycopg2://postgres:VOTRE_MOT_DE_PASSE@db.xxxxxxxx.supabase.co:5432/postgres

# Clé de signature des jetons JWT (une longue chaîne aléatoire, identique pour les 3 services)
JWT_SECRET=changez-moi

# Clé Google Maps (à restreindre à votre domaine dans la console Google)
GOOGLE_MAPS_API_KEY=

# Distance maximale client / point de dépôt pour valider une commande
DISTANCE_MAX_KM=1
